# ---------------------------------------------------------------------------
# SahAI — copy to .env and fill in. NEVER commit .env (it is gitignored).
# ---------------------------------------------------------------------------

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# ---------------------------------------------------------------------------
# Model tiers. Every model here is open-weights, served by Groq.
# Prices (USD per million tokens) live in app/config.py PRICING and are used by
# the cost ledger, so changing a model here changes the reported cost per call.
# ---------------------------------------------------------------------------
MODEL_TINY=meta-llama/llama-prompt-guard-2-86m
MODEL_CHEAP=llama-3.1-8b-instant
MODEL_STANDARD=openai/gpt-oss-20b
MODEL_HIGH=openai/gpt-oss-120b
MODEL_SAFETY=openai/gpt-oss-safeguard-20b
MODEL_STT=whisper-large-v3-turbo

# ---------------------------------------------------------------------------
# Demo controls
# ---------------------------------------------------------------------------
# 1 = run the real orchestrator and real code guardrails against canned agent
#     outputs. No network calls. The live-demo safety net.
SAHAI_MOCK=0

# Seconds between turns during scripted transcript playback.
PLAYBACK_INTERVAL_SECONDS=3.5

# ---------------------------------------------------------------------------
# Infra
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/sahai.db
CHROMA_DIR=./app/rag/store
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Telephony (optional — only needed to take real phone calls)
#
# Carriers must be able to reach this server, so PUBLIC_BASE_URL has to be a
# public https URL. In development: `ngrok http 8000` and paste the URL here.
# Then point your Twilio number's Voice webhook at:
#     <PUBLIC_BASE_URL>/api/telephony/voice
#
# Leave blank to skip telephony. `python simulate_phone_call.py` exercises the
# whole path locally with no account, no number and no tunnel.
# ---------------------------------------------------------------------------
PUBLIC_BASE_URL=
# Enables X-Twilio-Signature verification. Set this before exposing the webhook
# publicly — it is what stops a stranger opening call sessions on your account.
TWILIO_AUTH_TOKEN=
# Which CRM record an inbound call is attributed to. Override per number with a
# ?customer_id=... query param on the webhook URL.
DEFAULT_CUSTOMER_ID=CUST-1042

# INR per USD — used only to render the ₹ figure in the cost ledger.
USD_TO_INR=83.0
